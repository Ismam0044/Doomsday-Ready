{
  "name": "doomsday-ready",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "setup": "node --env-file=.env scripts/setup.js",
    "test": "node --test server/test/logic.test.js",
    "build": "npm --workspace client run build",
    "start": "npm --workspace server run start"
  }
}
